#include <stdio.h>
#include <string.h>
#include <stdlib.h>

// ================== 1. 枚举定义 ==================
typedef enum { SPRING, SUMMER, AUTUMN, WINTER } Season;
typedef enum { LIGHT, MEDIUM, DEEP } SkinTone;
typedef enum { WORK, DATE, CASUAL, SPORT, FORMAL } Occasion;
typedef enum { MALE, FEMALE } Gender;

// ================== 2. 结构体定义 ==================
// 天气信息
typedef struct {
    int temperature;    // 温度（摄氏度）
    int humidity;       // 湿度百分比
    int isRainy;        // 是否下雨 0/1
} Weather;

// 用户画像
typedef struct {
    float height;       // 身高 cm
    float weight;       // 体重 kg
    Gender gender;
    SkinTone skinTone;
    Season season;
    Weather weather;
    Occasion occasion;
} UserProfile;

int main() {
    printf("=== AI智能穿搭助手 (v1.0) ===\n");
    printf("系统启动成功。基础数据模型已构建完毕。\n");
    printf("当前包含：季节、肤色、场合、性别枚举及用户/天气结构体。\n");

    // 测试创建一个空的用户对象
    UserProfile user;
    user.height = 0;
    user.weight = 0;

    return 0;
}
